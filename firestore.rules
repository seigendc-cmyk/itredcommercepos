rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Vendors root and all sub-collections
    match /vendors/{vendorId} {
      allow read, write: if request.auth != null;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null;
      }
    }
    
    // General fallback for any authenticated user
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
